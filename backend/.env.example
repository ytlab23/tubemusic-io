DB_URI="mongodb+srv://USER:PASS@HOST/DB?retryWrites=true&w=majority"
PORT=3000

# YouTube Data API v3 — comma-separated rotation pool (sequential failover on quota / 403 / 429).
# Provide at least one. The rotator cools a key for 1h after a quota error.
YOUTUBE_API_KEYS=key1,key2,key3

# Required. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=replace-me

# CORS allow-list. Comma-separated origins, or "*" to allow all.
CORS_ORIGINS=https://tubemusic.io,https://www.tubemusic.io

TUBEPILOT_URL=https://tubepilot.ai/wp-json/tubepilot/v1
TUBEPILOT_API_KEY=

GEMINI_API_KEY=
RAPIDAPI_MP3_KEY=
RAPIDAPI_MP3_HOST=youtube-mp3-2025.p.rapidapi.com
AUDIO_FREE_DAILY_LIMIT=2
AUDIO_FREE_MAX_DURATION_SECONDS=1200
AUDIO_PRO_MAX_DURATION_SECONDS=3600
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
WHOP_PRODUCT_EXTERNAL_ID=tubemusic-pro
WHOP_PRODUCT_TITLE=TubeMusic
WHOP_SUCCESS_URL=https://tubemusic.io/account?tab=subscription&success=1
WHOP_CANCEL_URL=https://tubemusic.io/pro?canceled=1
PREMIUM_MONTHLY_PRICE_USD=2.90
PREMIUM_YEARLY_PRICE_USD=19.90
TURNSTILE_SECRET=
